# Supabase project URL and public publishable key (safe for browser use).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only credential used by trusted campaign persistence. Never prefix
# this variable with NEXT_PUBLIC_ and never use it in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server-only SerpApi key. Never prefix this variable with NEXT_PUBLIC_.
SERPAPI_API_KEY=your-serpapi-api-key

# Server-only Gemini API settings. AI_API_URL is the Gemini API base URL.
AI_API_URL=https://your-ai-provider-api-base-url
AI_API_KEY=your-ai-provider-api-key
AI_MODEL=your-ai-model-name

# Never add service-role or real provider credentials to source control.
